{
    "name": "searcher",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun check && bun --hot src/index.ts",
        "start": "NODE_ENV=production bun --preload ./src/instrumentation.ts src/index.ts",
        "build": "bun check && bun run build.ts",
        "test": "bun check && bun test",
        "test:coverage": "bun check && bun test --coverage",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@opentelemetry/api": "^1.10.0",
        "@opentelemetry/exporter-trace-otlp-proto": "^0.301.1",
        "@opentelemetry/resources": "^3.1.1",
        "@opentelemetry/sdk-node": "^0.301.1",
        "@opentelemetry/sdk-trace": "^3.1.1",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-slot": "^1.2.3",
        "@sentry/node-core": "^10.75.2",
        "bun-plugin-tailwind": "^0.1.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.545.0",
        "p-queue": "10.0.0",
        "react": "^19",
        "react-dom": "^19",
        "tailwind-merge": "^3.3.1"
    },
    "devDependencies": {
        "@opentelemetry/context-async-hooks": "^3.1.1",
        "@types/bun": "^1.4.4",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.1.11",
        "tw-animate-css": "^1.4.0"
    }
}
